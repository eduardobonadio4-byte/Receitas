# Obrigatório (exceto com --mock-claude)
ANTHROPIC_API_KEY=sk-ant-...

# Opcionais
CLAUDE_MODEL=claude-sonnet-5-5
WHISPER_MODEL=small          # tiny | base | small | medium | large-v3
WHISPER_LANGUAGE=pt
WHISPER_DEVICE=auto          # auto | cpu | cuda
# Sobrescreve a detecção automática da pasta de projetos do CapCut
# CAPCUT_DRAFTS_DIR=C:\Users\voce\AppData\Local\CapCut\User Data\Projects\com.lveditor.draft

# Notion: Banco de Receitas (deixe NOTION_TOKEN vazio para rodar sem Notion)
NOTION_TOKEN=ntn_...
NOTION_DATA_SOURCE_ID=8d44c394-93f3-49d2-af5a-33b259f707ff

# Página de vendas usada nos links ?src=pin-<slug>
SALES_PAGE_URL=https://receitaspraticasfit.com.br/
# Fonte dos textos no CapCut (Figtree não existe no catálogo do CapCut)
CAPCUT_FONT=Poppins_Bold
